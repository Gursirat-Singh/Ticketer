# ---- Server ----
NODE_ENV=development
PORT=5000
# Allowed browser origin(s) for CORS + CSRF origin check (comma separated)
CLIENT_URL=http://localhost:5173
# Timezone used when formatting dates in emails and PDF tickets
APP_TIMEZONE=Asia/Kolkata

# ---- Database ----
MONGO_URI=mongodb://127.0.0.1:27017/cinema_booking

# ---- Auth (use long random strings; generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))") ----
JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=7

# ---- Booking rules ----
SEAT_HOLD_SECONDS=300
MAX_SEATS_PER_BOOKING=10
# Amounts are in paise (INR x 100)
CONVENIENCE_FEE_PER_TICKET=2000
TAX_PERCENT=18
# Customers can cancel up to this many hours before the show starts
CANCEL_CUTOFF_HOURS=2

# ---- Payments ----
# "mock" works with no keys (simulated checkout). Set to "razorpay" and fill keys for Razorpay test mode.
PAYMENT_PROVIDER=mock
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Secret used to sign simulated payments/webhooks in mock mode
MOCK_PAYMENT_SECRET=mock-payment-secret

# ---- Email (optional). Without SMTP_HOST, emails are logged to the console instead of being sent ----
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Cinema Booking <no-reply@cinema.local>"
